#: backend/engine/i18n.py:16
msgid "Invalid imported movie metadata."
msgstr "Некорректные метаданные импортируемого фильма."

#: backend/engine/i18n.py:17
msgid "Movie ID conflict. The existing record was preserved."
msgstr "Конфликт ID фильма. Существующая запись сохранена."

#: backend/engine/i18n.py:18
#, python-format
msgid "Added: %(title)s."
msgstr "Добавлен фильм: %(title)s."


msgstr "Выберите знакомый фильм — найдём похожие фильмы по настроению и жанру."

#: backend/engine/i18n.py:80
msgid "Movie title or ID"
msgstr "Название или ID фильма"

#: backend/engine/i18n.py:81
msgid "For example, The Matrix or 1"

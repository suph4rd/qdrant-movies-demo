#, python-format
msgid "Could not process %(title)s: %(detail)s"
msgstr "Не удалось обработать %(title)s: %(detail)s"

#: backend/engine/i18n.py:21
msgid ""
"No saved movie found. Submit the form to search Wikidata and import exact"
" matches."
msgstr ""
"Сохранённый фильм не найден. Отправьте форму для поиска в Wikidata и "
"импорта точных совпадений."

#: backend/engine/i18n.py:22 backend/api/templates/index.html:63
#, python-format
msgid "Description language: %(language)s"
msgstr "Язык описания: %(language)s"

#: backend/engine/i18n.py:23 backend/api/templates/index.html:55 backend/api/templates/index.html:64
msgid "Source: TMDB"
msgstr "Источник: TMDB"

#: backend/engine/i18n.py:24
msgid "Movie not found in Wikidata."
msgstr "Фильм не найден в Wikidata."

#: backend/engine/i18n.py:25
msgid "Invalid Wikidata response or incomplete movie metadata."
msgstr "Некорректный ответ Wikidata или неполные данные фильма."

#: backend/engine/i18n.py:26
msgid "Wikidata request limit reached. Try again later."
msgstr "Достигнут лимит запросов Wikidata. Повторите позже."

#: backend/engine/i18n.py:27
msgid "Wikidata is unavailable. Try again later."
msgstr "Wikidata недоступна. Повторите позже."

#: backend/engine/i18n.py:28
#, python-format
msgid "Skipped incomplete Wikidata movie %(id)s."
msgstr "Пропущена неполная карточка Wikidata %(id)s."

#: backend/engine/i18n.py:29 backend/api/templates/index.html:53 backend/api/templates/index.html:64
msgid "Source: Wikidata"
msgstr "Источник: Wikidata"

#: backend/engine/i18n.py:30 backend/api/templates/index.html:64
msgid "Short description from Wikidata"
msgstr "Краткое описание из Wikidata"

#: backend/engine/i18n.py:31 backend/api/templates/index.html:54
msgid ""
"Wikidata provides a short description, not a plot summary. Plot-based "
"recommendations may be less precise."
msgstr ""
"Wikidata предоставляет краткое описание, а не пересказ сюжета. "
"Рекомендации по сюжету могут быть менее точными."

#: backend/engine/i18n.py:32 backend/api/templates/index.html:77
msgid "Wikidata structured data is available under CC0. No API key is required."
msgstr "Структурированные данные Wikidata доступны по CC0. Ключ API не требуется."

#: backend/engine/i18n.py:33 backend/api/templates/index.html:76
msgid "Credits"
msgstr "Источники"

#: backend/engine/i18n.py:35
msgid "Choose movie or description search."
msgstr "Выберите поиск по фильму или по описанию."

#: backend/engine/i18n.py:36 backend/api/templates/index.html:22
msgid "Search mode"
msgstr "Режим поиска"

#: backend/engine/i18n.py:37 backend/api/templates/index.html:25
msgid "By movie"
msgstr "По фильму"

#: backend/engine/i18n.py:38 backend/api/templates/index.html:26
msgid "By description"
msgstr "По описанию"

#: backend/engine/i18n.py:39 backend/api/templates/index.html:18
msgid "Choose a movie or describe what you want to watch in English or Russian."
msgstr ""
"Выберите фильм или опишите, что хотите посмотреть, на русском или "
"английском языке."

#: backend/engine/i18n.py:40 backend/api/templates/index.html:28
msgid "Movie title, ID, or description"
msgstr "Название, ID фильма или описание"

#: backend/engine/i18n.py:41 backend/api/templates/index.html:31
msgid "For example, The Matrix, 1, or an astronaut stranded on Mars"
msgstr "Например, Матрица, 1 или космонавт, застрявший на Марсе"

#: backend/engine/i18n.py:42 backend/api/templates/index.html:44
msgid ""
"In movie mode, enter a title or ID. In description mode, describe a plot "
"or mood in English or Russian."
msgstr ""
"В режиме «По фильму» введите название или ID. В режиме «По описанию» "
"опишите сюжет или настроение на русском или английском языке."

#: backend/engine/i18n.py:43 backend/api/templates/index.html:52
msgid "Movies matching your description"
msgstr "Фильмы по вашему описанию"

#: backend/engine/i18n.py:44 backend/api/templates/index.html:56
msgid ""
"Cosine similarity measures vector similarity, not the probability that "
"you will like a movie."
msgstr ""
"Косинусная близость показывает сходство векторов, а не вероятность того, "
"что фильм вам понравится."

#: backend/engine/i18n.py:46
msgid ""
"Incompatible semantic index. Reindex into a new collection with the "
"pinned model, revision, and text format."
msgstr ""
"Несовместимый семантический индекс. Переиндексируйте данные в новую "
"коллекцию с закреплённой моделью, revision и форматом текста."

#: backend/engine/i18n.py:47
#, python-format
msgid "Cannot write the embedding cache (%(path)s)."
msgstr "Не удалось записать кеш embeddings (%(path)s)."

#: backend/engine/i18n.py:48
msgid "TEI embedding service URL"
msgstr "URL сервиса embeddings TEI"

#: backend/engine/i18n.py:49
msgid "Semantic collection name (movies is reserved)"
msgstr "Имя семантической коллекции (movies зарезервировано)"

#: backend/engine/i18n.py:50
msgid "Embedding cache directory"
msgstr "Каталог кеша embeddings"

#: backend/engine/i18n.py:52
msgid "Enter a description in English or Russian."
msgstr "Введите описание на русском или английском языке."

#: backend/engine/i18n.py:53
#, python-format
msgid "Cannot reach the embedding model (%(url)s). Check that TEI is ready."
msgstr "Модель embeddings недоступна (%(url)s). Проверьте готовность TEI."

#: backend/engine/i18n.py:54
msgid ""
"Invalid embedding response: expected finite, nonzero 384-dimensional "
"vectors."
msgstr ""
"Некорректный ответ модели: ожидаются конечные ненулевые векторы "
"размерности 384."

#: backend/engine/i18n.py:55
msgid ""
"TEI model configuration does not match the pinned model, revision, "
"pooling, or dtype."
msgstr ""
"Настройки модели TEI не соответствуют закреплённой модели, revision, "
"pooling или dtype."

#: backend/engine/i18n.py:57
#, python-format
msgid "Qdrant HTTP %(status)s: %(detail)s"
msgstr "Qdrant HTTP %(status)s: %(detail)s"

#: backend/engine/i18n.py:58
msgid "Invalid Qdrant response."
msgstr "Некорректный ответ Qdrant."

#: backend/engine/i18n.py:59
#, python-format
msgid "Cannot connect to Qdrant (%(url)s): %(detail)s"
msgstr "Нет соединения с Qdrant (%(url)s): %(detail)s"

#: backend/engine/i18n.py:60
msgid ""
"Incompatible movies collection: one unnamed 10-dimensional vector with "
"Cosine distance is required. Existing data is unchanged."
msgstr ""
"Несовместимая коллекция movies: требуется один безымянный вектор "
"размерности 10, метрика Cosine. Существующие данные не изменены."

#: backend/engine/i18n.py:61
msgid ""
"The movies collection contains additional records; they are preserved. "
"This demo expects 250."
msgstr ""
"В movies есть дополнительные записи; они сохранены. Для демо ожидается "
"250."

#: backend/engine/i18n.py:62
#, python-format
msgid "Unknown movie ID: %(id)s. See movies.json for IDs."
msgstr "Неизвестный ID фильма: %(id)s. Посмотрите ID в movies.json."

#: backend/engine/i18n.py:63
#, python-format
msgid "Cannot read the movie catalog: %(detail)s"
msgstr "Не удалось прочитать каталог фильмов: %(detail)s"

#: backend/engine/i18n.py:64
msgid "JSON must contain exactly 250 movies."
msgstr "В JSON должно быть ровно 250 фильмов."

#: backend/engine/i18n.py:65
msgid "Each movie must be an object."
msgstr "Каждый фильм должен быть объектом."

#: backend/engine/i18n.py:66
#, python-format
msgid "Invalid or duplicate ID: %(id)s"
msgstr "Некорректный или повторяющийся ID: %(id)s"

#: backend/engine/i18n.py:67
#, python-format
msgid "Movie %(id)s: a nonzero vector of 10 numbers in the range 0–1 is required."
msgstr "Фильм %(id)s: нужен ненулевой вектор из 10 чисел в диапазоне 0–1."

#: backend/engine/i18n.py:68
#, python-format
msgid ""
"Movie %(id)s: title, description, and genres are required in both "
"languages."
msgstr "Фильм %(id)s: нужны название, описание и жанры на обоих языках."

#: backend/engine/i18n.py:69
#, python-format
msgid "Movie %(id)s: invalid year or genres."
msgstr "Фильм %(id)s: некорректные год или жанры."

#: backend/engine/i18n.py:70
msgid "ID must be an integer from 0 to 2^64−1."
msgstr "ID должен быть целым числом от 0 до 2^64−1."

#: backend/engine/i18n.py:71
msgid "Enter a movie title or ID."
msgstr "Введите название или ID фильма."

#: backend/engine/i18n.py:72
msgid "Movie not found. Enter another title or ID."
msgstr "Фильм не найден. Введите другое название или ID."

#: backend/engine/i18n.py:73
#, python-format
msgid "Multiple movies found. Please specify the title: %(titles)s."
msgstr "Найдено несколько фильмов. Уточните название: %(titles)s."

#: backend/engine/i18n.py:74
msgid "The recommendation count must be an integer from 1 to 249."
msgstr "Количество рекомендаций должно быть целым числом от 1 до 249."

#: backend/engine/i18n.py:75
msgid "Choose the number of similar movies: 5, 10, 20, or 50."
msgstr "Выберите количество похожих фильмов: 5, 10, 20 или 50."

#: backend/engine/i18n.py:76 backend/api/templates/index.html:6
msgid "Your next movie"
msgstr "Следующий фильм"

#: backend/engine/i18n.py:77 backend/api/templates/index.html:16

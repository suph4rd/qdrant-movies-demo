# Host ports published on IPv4 loopback. Container ports remain fixed.
WEB_PORT=18000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Qdrant endpoint used by both Docker application services.
QDRANT_URL=http://qdrant:6333

# Embedding service shared by web and loader. Local Python uses port 18080.
TEI_PORT=18080
EMBEDDING_URL=http://tei:18080
MOVIES_COLLECTION=movies_semantic_v1

# Default: ARM64 CPU, TEI 1.9.4 (immutable digest).
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9@sha256:798cd7615e060a72ccbdf19aa0ada52289c6a0147490195bafaece6ce04d70f1
# On x86_64 CPU replace TEI_IMAGE with:
# ghcr.io/huggingface/text-embeddings-inference:cpu-1.9@sha256:2538ea1c9640d3763b15af668039d24172d063b42337b0c27796fc2be180c78d
